# Controller configuration (see packages/config in a later page for the
# Zod-validated schema this maps to). Copy to .env and fill in — never commit
# the real .env.

# HTTP/WS port the controller listens on
PORT=4000

# Directory for SQLite DB + logs (default: ~/.claudeops)
DATA_DIR=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# How long a mobile pairing token stays valid (seconds)
PAIRING_TOKEN_TTL=2592000

# Interval (ms) for bounded discovery polling of `claude agents --json`
# NOTE (page21): defined but not currently wired to anything — process
# discovery only runs once, at startup. See .claude/RISKS.md.
DISCOVERY_POLL_INTERVAL_MS=15000

# Optional: path to a log file for a headless 24/7 run. Unset (default)
# means stdout only. See packages/logging/src/rotation.md.
LOG_FILE=
LOG_MAX_FILE_BYTES=10485760
LOG_MAX_FILES=5

# Optional: Bordio integration (Phase 2, pageB3). Unset (default) means
# it's fully disabled. Server-side only — never put this in the mobile
# app. See .claude/research/bordio.md and .claude/decisions/ADR-006.md.
BORDIO_API_KEY=
# Optional: which Bordio task-status definition ids to use for
# open/closed session state. If unset, auto-discovered from your
# workspace's own definitions on first sync.
BORDIO_OPEN_STATUS_ID=
BORDIO_CLOSED_STATUS_ID=
# Optional: inbound command polling (Phase 2, pageB4). Unset (default)
# means it's off, even with BORDIO_API_KEY set — outbound-only is a
# valid configuration. Set to the Bordio tag id that marks a task as a
# command for ClaudeOps (only linked tasks pageB3 already created for a
# session can receive one — see .claude/plans/pageB4.md).
BORDIO_COMMAND_TAG_ID=
BORDIO_POLL_INTERVAL_MS=60000
