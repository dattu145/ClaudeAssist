# Controller configuration (see packages/config in a later page for the
# Zod-validated schema this maps to). Copy to .env and fill in — never commit
# the real .env.

# HTTP/WS port the controller listens on
PORT=4000

# Directory for SQLite DB + logs (default: ~/.claudeops)
DATA_DIR=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# How long a mobile pairing token stays valid (seconds)
PAIRING_TOKEN_TTL=2592000

# Interval (ms) for bounded discovery polling of `claude agents --json`
DISCOVERY_POLL_INTERVAL_MS=15000
